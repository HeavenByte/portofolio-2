---
// src/pages/index.astro
import '../styles/global.css';

// Mengambil data repositori publik dari GitHub API untuk user HeavenByte
let repositories = [];
try {
  const response = await fetch('https://api.github.com/users/HeavenByte/repos?sort=updated&per_page=6');
  if (response.ok) {
    repositories = await response.json();
  }
} catch (error) {
  console.error('Gagal mengambil data dari GitHub:', error);
}
---

<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HeavenByte // Haichel</title>
    <style>
      @keyframes pulse-glow {
        0%, 100% { opacity: 0.4; filter: drop-shadow(0 0 2px rgba(0, 255, 102, 0.4)); }
        50% { opacity: 1; filter: drop-shadow(0 0 12px rgba(0, 255, 102, 0.9)); }
      }
      .animate-pulse-glow {
        animation: pulse-glow 2.5s infinite ease-in-out;
      }
      @keyframes text-glow {
        0%, 100% { color: #00ff66; text-shadow: none; }
        50% { color: #ffffff; text-shadow: 0 0 12px rgba(255, 255, 255, 0.9), 0 0 20px rgba(0, 255, 102, 0.6); }
      }
      .bio-1 { animation: text-glow 6s infinite 0s; }
      .bio-2 { animation: text-glow 6s infinite 1.5s; }
      .bio-3 { animation: text-glow 6s infinite 3s; }
      .bio-4 { animation: text-glow 6s infinite 4.5s; }
    </style>
  </head>
  <body class="bg-[#050505] text-[#00ff66] font-mono selection:bg-[#00ff66] selection:text-black min-h-screen antialiased relative overflow-x-hidden">

    {/* Canvas Background Matrix Rain */}
    <canvas id="matrix-canvas" class="fixed inset-0 pointer-events-none opacity-20 z-0 w-full h-full"></canvas>

    {/* Top Navbar */}
    <header class="border-b border-[#00ff66]/20 bg-[#0a0a0a]/90 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center text-sm">
        <div class="flex items-center space-x-2">
          <span class="inline-block w-3 h-3 rounded-full bg-red-500/80"></span>
          <span class="inline-block w-3 h-3 rounded-full bg-yellow-500/80"></span>
          <span class="inline-block w-3 h-3 rounded-full bg-[#00ff66]/80"></span>
          <span class="ml-2 text-zinc-400 text-xs hidden sm:inline">bash - heavenbyte@sys:~</span>
        </div>
        <nav class="space-x-6 text-xs sm:text-sm">
          <a href="#about" class="hover:text-white transition">~/about</a>
          <a href="#projects" class="hover:text-white transition">~/projects</a>
          <a href="#contact" class="hover:text-white transition">~/contact</a>
        </nav>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-4 py-12 space-y-24 relative z-10">

      {/* Hero / Home Section */}
      <section id="about" class="space-y-6 pt-6">
        <div class="text-zinc-500 text-xs sm:text-sm">$ whoami --interactive</div>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
          HeavenByte <span class="text-[#00ff66] font-normal animate-pulse">_</span>
        </h1>
        <p class="text-zinc-400 max-w-xl leading-relaxed text-sm sm:text-base space-y-1">
          <span class="bio-1 inline-block">Hey, I'm Haichel Heaven — an active student at Universitas Islam Kalimantan (UNISKA) Banjarbaru with a huge passion for coding.</span>{' '}
          <span class="bio-2 inline-block">By day, I handle a dual role as a Technician and Admin at CV Twincom Group.</span>{' '}
          <span class="bio-3 inline-block">Mixing up hands-on hardware tinkering, admin workflow, and web development.</span>{' '}
          <span class="bio-4 inline-block font-semibold text-white">Always ready to tackle any tech challenge.</span>
        </p>
      </section>

      {/* Pendidikan & Pengalaman Kerja (Interactive Timeline) */}
      <section class="space-y-16 pt-6">
        <div class="space-y-3">
          <div class="text-zinc-500 text-xs sm:text-sm">$ cat ./history.log</div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-wider">EDUCATION & EXPERIENCE</h2>
          <div class="w-16 h-0.5 bg-[#00ff66]"></div>
        </div>

        {/* PENDIDIKAN TIMELINE */}
        <div class="space-y-8">
          <div class="text-xs text-zinc-500 tracking-wider uppercase flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#00ff66] animate-pulse"></span>
            — PENDIDIKAN
          </div>

          <div class="relative border-l-2 border-[#00ff66]/30 ml-3 sm:ml-6 pl-6 sm:pl-10 space-y-10">
            
            {/* SD */}
            <div class="relative group">
              <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#050505] border-2 border-[#00ff66]/60 group-hover:bg-[#00ff66] transition duration-300"></span>
              <div class="p-5 bg-zinc-950/80 border border-[#00ff66]/20 rounded-lg hover:border-[#00ff66] hover:bg-zinc-900/40 transition duration-300 space-y-2 backdrop-blur">
                <span class="text-xs text-[#00ff66] font-semibold">// SD</span>
                <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-[#00ff66] transition">SD Santa Angela II Banjarmasin</h3>
                <p class="text-xs text-zinc-400">Sekolah Dasar</p>
              </div>
            </div>

            {/* SMP */}
            <div class="relative group">
              <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#050505] border-2 border-[#00ff66]/60 group-hover:bg-[#00ff66] transition duration-300"></span>
              <div class="p-5 bg-zinc-950/80 border border-[#00ff66]/20 rounded-lg hover:border-[#00ff66] hover:bg-zinc-900/40 transition duration-300 space-y-2 backdrop-blur">
                <span class="text-xs text-[#00ff66] font-semibold">// SMP</span>
                <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-[#00ff66] transition">SMPN 1 Martapura</h3>
                <p class="text-xs text-zinc-400">Sekolah Menengah Pertama</p>
              </div>
            </div>

            {/* SMK */}
            <div class="relative group">
              <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#050505] border-2 border-[#00ff66]/60 group-hover:bg-[#00ff66] transition duration-300"></span>
              <div class="p-5 bg-zinc-950/80 border border-[#00ff66]/20 rounded-lg hover:border-[#00ff66] hover:bg-zinc-900/40 transition duration-300 space-y-2 backdrop-blur">
                <span class="text-xs text-[#00ff66] font-semibold">// SMK</span>
                <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-[#00ff66] transition">SMKN 1 Martapura</h3>
                <p class="text-xs text-zinc-400">Sekolah Menengah Kejuruan</p>
              </div>
            </div>

            {/* UNISKA (Aktif) */}
            <div class="relative group">
              <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#00ff66] border-2 border-white animate-pulse-glow"></span>
              <div class="p-5 bg-zinc-950/90 border border-[#00ff66]/60 rounded-lg hover:border-[#00ff66] hover:bg-zinc-900/60 transition duration-300 space-y-3 shadow-lg shadow-[#00ff66]/10 backdrop-blur">
                <div class="flex justify-between items-center">
                  <span class="text-xs text-[#00ff66] font-semibold">2024 — SEKARANG</span>
                  <span class="text-[10px] bg-[#00ff66]/20 text-[#00ff66] border border-[#00ff66]/40 px-2 py-0.5 rounded animate-pulse">AKTIF</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-white">Universitas Islam Kalimantan (UNISKA)</h3>
                <p class="text-xs text-zinc-400">Mahasiswa Aktif</p>
              </div>
            </div>

          </div>
        </div>

        {/* PENGALAMAN KERJA TIMELINE */}
        <div class="space-y-8 pt-6">
          <div class="text-xs text-zinc-500 tracking-wider uppercase flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#00ff66] animate-pulse"></span>
            — PENGALAMAN KERJA
          </div>

          <div class="relative border-l-2 border-[#00ff66]/30 ml-3 sm:ml-6 pl-6 sm:pl-10 space-y-8">
            <div class="relative group">
              <span class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-[#00ff66] border-2 border-white animate-pulse-glow"></span>
              <div class="p-6 bg-zinc-950/90 border border-[#00ff66]/60 rounded-lg hover:border-[#00ff66] hover:bg-zinc-900/60 transition duration-300 space-y-3 shadow-lg shadow-[#00ff66]/10 backdrop-blur">
                <div class="flex justify-between items-center">
                  <span class="text-xs text-[#00ff66] font-semibold">2025 — 2026</span>
                  <span class="text-[10px] bg-[#00ff66]/20 text-[#00ff66] border border-[#00ff66]/40 px-2 py-0.5 rounded animate-pulse">AKTIF</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-white">Teknisi & Admin — CV Twincom Group</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Menangani inspeksi perangkat keras & lunak komputer, manajemen servis, klaim garansi, dan administrasi operasional harian.
                </p>
              </div>
            </div>
          </div>
        </div>

      </section>

      {/* Projects Section (Dynamic GitHub) */}
      <section id="projects" class="space-y-6 pt-10">
        <div class="text-zinc-500 text-xs sm:text-sm">$ curl -s https://api.github.com/users/HeavenByte/repos</div>
        
        {repositories.length === 0 ? (
          <div class="border border-[#00ff66]/20 bg-zinc-950/80 p-5 rounded text-zinc-500 text-sm">
            // Sedang memuat repositori dari GitHub HeavenByte...
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {repositories.map((repo: any) => (
              <div class="border border-[#00ff66]/20 bg-zinc-950/80 backdrop-blur p-5 rounded-lg space-y-3 hover:border-[#00ff66] transition duration-300 group flex flex-col justify-between">
                <div class="space-y-2">
                  <div class="flex justify-between items-start">
                    <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-[#00ff66] transition wrap-break-words">
                      {repo.name}
                    </h3>
                    <span class="text-[11px] text-zinc-400 border border-zinc-800 px-2 py-0.5 bg-black/50 rounded">
                      {repo.language || 'Code'}
                    </span>
                  </div>
                  <p class="text-zinc-400 text-xs sm:text-sm leading-relaxed">
                    {repo.description || 'Tidak ada deskripsi tersedia pada repositori ini.'}
                  </p>
                </div>
                <div class="flex items-center justify-between pt-4 text-xs border-t border-zinc-900 mt-2">
                  <span class="text-[#00ff66] flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-[#00ff66] animate-pulse"></span>
                    ★ {repo.stargazers_count} &bull; ⑂ {repo.forks_count}
                  </span>
                  <a 
                    href={repo.html_url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-[#00ff66] hover:underline flex items-center gap-1 font-semibold"
                  >
                    [ Repository ↗ ]
                  </a>
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      {/* Contact Section */}
      <section id="contact" class="space-y-4 pb-12 pt-10">
        <div class="text-zinc-500 text-xs sm:text-sm">$ ping social_channels</div>
        <div class="border border-[#00ff66]/20 bg-zinc-950/80 backdrop-blur p-6 rounded-lg space-y-4">
          <p class="text-zinc-400 text-sm">
            Terhubung langsung melalui saluran resmi HeavenByte:
          </p>
          <div class="flex flex-wrap gap-4 text-sm pt-2">
            
            {/* GitHub */}
            <a href="https://github.com/HeavenByte" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 border border-[#00ff66]/30 bg-black/40 hover:border-[#00ff66] hover:bg-[#00ff66]/10 text-[#00ff66] rounded transition duration-300">
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              <span>GitHub</span>
            </a>

            {/* Instagram */}
            <a href="https://instagram.com/haichelheaven" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 border border-[#00ff66]/30 bg-black/40 hover:border-[#00ff66] hover:bg-[#00ff66]/10 text-[#00ff66] rounded transition duration-300">
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              <span>Instagram</span>
            </a>

            {/* LinkedIn */}
            <a href="https://www.linkedin.com/in/haichel-heaven-suriyaman-9b229426a?originalSubdomain=id" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 border border-[#00ff66]/30 bg-black/40 hover:border-[#00ff66] hover:bg-[#00ff66]/10 text-[#00ff66] rounded transition duration-300">
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              <span>LinkedIn</span>
            </a>

          </div>
        </div>
      </section>

    </main>

    {/* Footer */}
    <footer class="border-t border-[#00ff66]/20 py-6 text-center text-xs text-zinc-600 relative z-10">
      <p>© 2026 HeavenByte. System operational. Built with Astro & Tailwind CSS.</p>
    </footer>

    {/* Matrix Rain Script */}
    <script>
      const canvas = document.getElementById('matrix-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d');

      if (ctx) {
        const resizeCanvas = () => {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        };
        resizeCanvas();

        const katakana = '0123456789ABCDEFHIJKLMNOPQRSTUVWXYZ';
        const alphabet = katakana.split('');

        const fontSize = 14;
        let columns = Math.floor(canvas.width / fontSize);

        const rainDrops: number[] = [];
        for (let x = 0; x < columns; x++) {
          rainDrops[x] = 1;
        }

        const draw = () => {
          ctx.fillStyle = 'rgba(5, 5, 5, 0.05)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          ctx.fillStyle = '#00ff66';
          ctx.font = fontSize + 'px monospace';

          for (let i = 0; i < rainDrops.length; i++) {
            const text = alphabet[Math.floor(Math.random() * alphabet.length)];
            ctx.fillText(text, i * fontSize, rainDrops[i] * fontSize);

            if (rainDrops[i] * fontSize > canvas.height && Math.random() > 0.975) {
              rainDrops[i] = 0;
            }
            rainDrops[i]++;
          }
        };

        setInterval(draw, 30);

        window.addEventListener('resize', () => {
          resizeCanvas();
          columns = Math.floor(canvas.width / fontSize);
          for (let x = 0; x < columns; x++) {
            if (!rainDrops[x]) rainDrops[x] = 1;
          }
        });
      }
    </script>

  </body>
</html>